NUXT_PUBLIC_SITE_URL=https://terra-spice.vercel.app

# Enquiry email delivery via Resend. Without these, enquiries are logged server-side only.
RESEND_API_KEY=
INQUIRY_TO_EMAIL=sales@example.com
INQUIRY_FROM_EMAIL=Terra Spice <onboarding@resend.dev>
